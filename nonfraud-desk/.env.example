GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Bolt address of the behaviour graph. Leave unset to read data/behaviour-index.json instead.
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=nonfraud-local

# January transaction vectors used when scanning a proposed behaviour.
# BEHAVIOUR_UI=/path/to/Behaviour_ui

# Cloud Run, if you would rather use the runtime service account than an API key
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=asia-southeast1
