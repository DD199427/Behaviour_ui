// ---- 5. Vector indexes (cosine) for similarity search
CREATE VECTOR INDEX bb_account_profile IF NOT EXISTS FOR (a:Account) ON (a.bb_profile_vec)
OPTIONS {indexConfig: {`vector.dimensions`: 31, `vector.similarity_function`: 'cosine'}};
CREATE VECTOR INDEX bb_merchant_profile IF NOT EXISTS FOR (m:Merchant) ON (m.bb_merchant_vec)
OPTIONS {indexConfig: {`vector.dimensions`: 31, `vector.similarity_function`: 'cosine'}};
CREATE VECTOR INDEX bb_txn_behaviour IF NOT EXISTS FOR (t:Transaction) ON (t.bb_txn_vec)
OPTIONS {indexConfig: {`vector.dimensions`: 46, `vector.similarity_function`: 'cosine'}};

// ---- 6. Checks: nodes of each label that did NOT get a vector (non-zero means IDs didn't match)
MATCH (a:Account) WHERE a.bb_profile_vec IS NULL RETURN count(a) AS accounts_without_vector;
MATCH (m:Merchant) WHERE m.bb_merchant_vec IS NULL RETURN count(m) AS merchants_without_vector;
MATCH (a:Account) WHERE a.bb_profile_vec IS NOT NULL RETURN count(a) AS accounts_loaded;   // expect 8817
MATCH (m:Merchant) WHERE m.bb_merchant_vec IS NOT NULL RETURN count(m) AS merchants_loaded; // expect 861

// ---- Example: the 10 accounts that behave most like a given one
// MATCH (a:Account {account_id: '<account id>'})
// CALL db.index.vector.queryNodes('bb_account_profile', 10, a.bb_profile_vec) YIELD node, score
// RETURN node.account_id AS account, score ORDER BY score DESC;
