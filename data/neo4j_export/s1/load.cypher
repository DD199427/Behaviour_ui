// Behaviour-vector export s1 / v1 (data as of 2026-09-30), generated by build_behaviour_vectors.py.
//
// What this does: finds EXISTING nodes by their ID and adds vector properties to them. It creates no nodes and
// no relationships. Rows whose node isn't found are skipped (see the checks at the end).
//
// Before running:
//   1. Copy account_vectors.csv, merchant_vectors.csv (and the transaction_vectors/ folder, if present)
//      into the Neo4j import folder.
//   2. Check the node labels and ID properties below match your graph:
//        :Account(account_id)   :Merchant(name, category)   :Transaction(txn_id)
//      If not, regenerate the export with --account-label / --account-id-prop / ... or edit them here.
//      IDs are loaded as strings. If your graph stores card numbers as integers, use toInteger(row.account_id)
//      (19-digit card numbers can exceed the integer range, so strings are safer).
//   3. Run with cypher-shell (cypher-shell -f load.cypher). In Neo4j Browser, put :auto in front of each
//      LOAD CSV statement (needed for CALL ... IN TRANSACTIONS).
// Needs Neo4j 5.x. Vector indexes need 5.13+ (for 5.11-5.12 use db.index.vector.createNodeIndex instead).
// Re-running is safe: the same properties are overwritten.

// ---- 1. Lookup indexes so the MATCH below is fast (no uniqueness constraint, so nothing in your graph can fail)
CREATE INDEX bb_account_id IF NOT EXISTS FOR (a:Account) ON (a.account_id);
CREATE INDEX bb_merchant_key IF NOT EXISTS FOR (m:Merchant) ON (m.name, m.category);
CREATE INDEX bb_txn_id IF NOT EXISTS FOR (t:Transaction) ON (t.txn_id);

// ---- 2. Accounts (8817 rows, 31 numbers each)
LOAD CSV WITH HEADERS FROM 'file:///account_vectors.csv' AS row
CALL {
  WITH row
  MATCH (a:Account {account_id: row.account_id})
  SET a.bb_profile_vec = [x IN split(row.bb_profile_vec, ';') | toFloat(x)],
      a.bb_profile_mask = [x IN split(row.bb_profile_mask, ';') | toInteger(x)],
      a.bb_schema = row.bb_schema, a.bb_version = row.bb_version, a.bb_asof = date(row.bb_asof)
} IN TRANSACTIONS OF 5000 ROWS;

// ---- 3. Merchants (861 rows; activity vector 31 numbers, cpp vector 3)
// bb_merchant_cpp_vec is built from fraud flags: only use it with a time-ordered train/test split (see README).
LOAD CSV WITH HEADERS FROM 'file:///merchant_vectors.csv' AS row
CALL {
  WITH row
  MATCH (m:Merchant {name: row.merchant_name, category: row.category})
  SET m.bb_merchant_vec = [x IN split(row.bb_merchant_vec, ';') | toFloat(x)],
      m.bb_merchant_mask = [x IN split(row.bb_merchant_mask, ';') | toInteger(x)],
      m.bb_merchant_cpp_vec = [x IN split(row.bb_merchant_cpp_vec, ';') | toFloat(x)],
      m.bb_merchant_cpp_mask = [x IN split(row.bb_merchant_cpp_mask, ';') | toInteger(x)],
      m.bb_schema = row.bb_schema, m.bb_version = row.bb_version, m.bb_asof = date(row.bb_asof)
} IN TRANSACTIONS OF 5000 ROWS;

// ---- 4. Transactions (490407 rows, 46 numbers each; range: 2025-01-01 to 2025-01-31)
// The parts are gzip-compressed. If your Neo4j can't read .csv.gz, unzip them first or use load_neo4j.py.
LOAD CSV WITH HEADERS FROM 'file:///transaction_vectors/part-0001.csv.gz' AS row
CALL {
  WITH row
  MATCH (t:Transaction {txn_id: row.txn_id})
  SET t.bb_txn_vec = [x IN split(row.bb_txn_vec, ';') | toFloat(x)],
      t.bb_txn_mask = [x IN split(row.bb_txn_mask, ';') | toInteger(x)],
      t.bb_schema = row.bb_schema, t.bb_version = row.bb_version, t.bb_asof = date(row.bb_asof)
} IN TRANSACTIONS OF 10000 ROWS;

