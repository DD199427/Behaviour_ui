// Behaviour map s1 / v1 (as of 2026-09-30), generated by build_behaviour_map.py.
// Loads behaviour_map.csv: copy it into the Neo4j import folder, then run with cypher-shell
// (in Neo4j Browser put :auto in front of each LOAD CSV). Needs Neo4j 5.x; no APOC or GDS.
// Accounts and merchants must already exist (matched by ID); BehaviourGroup nodes are created.
// Re-running is safe: MERGE does not duplicate relationships or groups.
// JSON columns: properties_json holds every relationship property; target_properties_json the group's
// properties. With APOC you can add them all with: SET r += apoc.convert.fromJsonMap(row.properties_json)

CREATE CONSTRAINT bb_group_id IF NOT EXISTS FOR (g:BehaviourGroup) REQUIRE g.group_id IS UNIQUE;
CREATE INDEX bb_account_id IF NOT EXISTS FOR (a:Account) ON (a.account_id);
CREATE INDEX bb_merchant_key IF NOT EXISTS FOR (m:Merchant) ON (m.name, m.category);

// 1. Behaviour groups (nodes) and membership
LOAD CSV WITH HEADERS FROM 'file:///behaviour_map.csv' AS row
WITH row WHERE row.rel_type = 'IN_BEHAVIOUR_GROUP' AND row.source_label = 'Account'
CALL {
  WITH row
  MATCH (a:Account {account_id: row.source_id})
  MERGE (g:BehaviourGroup {group_id: row.target_id})
  SET g.entity = 'account', g.properties_json = row.target_properties_json,
      g.schema = row.schema, g.version = row.version, g.asof = date(row.asof)
  MERGE (a)-[r:IN_BEHAVIOUR_GROUP]->(g)
  SET r.properties_json = row.properties_json
} IN TRANSACTIONS OF 10000 ROWS;

LOAD CSV WITH HEADERS FROM 'file:///behaviour_map.csv' AS row
WITH row WHERE row.rel_type = 'IN_BEHAVIOUR_GROUP' AND row.source_label = 'Merchant'
CALL {
  WITH row
  MATCH (m:Merchant {name: row.source_id, category: row.source_category})
  MERGE (g:BehaviourGroup {group_id: row.target_id})
  SET g.entity = 'merchant', g.properties_json = row.target_properties_json,
      g.schema = row.schema, g.version = row.version, g.asof = date(row.asof)
  MERGE (m)-[r:IN_BEHAVIOUR_GROUP]->(g)
  SET r.properties_json = row.properties_json
} IN TRANSACTIONS OF 10000 ROWS;

// 2. Similarity links
LOAD CSV WITH HEADERS FROM 'file:///behaviour_map.csv' AS row
WITH row WHERE row.rel_type = 'BEHAVES_LIKE' AND row.source_label = 'Account'
CALL {
  WITH row
  MATCH (a:Account {account_id: row.source_id}), (b:Account {account_id: row.target_id})
  MERGE (a)-[r:BEHAVES_LIKE]->(b)
  SET r.score = toFloat(row.score), r.rank = toInteger(row.rank), r.properties_json = row.properties_json,
      r.schema = row.schema, r.version = row.version
} IN TRANSACTIONS OF 10000 ROWS;

LOAD CSV WITH HEADERS FROM 'file:///behaviour_map.csv' AS row
WITH row WHERE row.rel_type = 'BEHAVES_LIKE' AND row.source_label = 'Merchant'
CALL {
  WITH row
  MATCH (m:Merchant {name: row.source_id, category: row.source_category}),
        (n:Merchant {name: row.target_id, category: row.target_category})
  MERGE (m)-[r:BEHAVES_LIKE]->(n)
  SET r.score = toFloat(row.score), r.rank = toInteger(row.rank), r.properties_json = row.properties_json,
      r.schema = row.schema, r.version = row.version
} IN TRANSACTIONS OF 10000 ROWS;

// 3. Checks (expected counts from the CSV: 88170 account links, 4 account groups, 8610 merchant links, 10 merchant groups)
MATCH (:Account)-[r:BEHAVES_LIKE]->(:Account) RETURN count(r) AS account_links;
MATCH (:Merchant)-[r:BEHAVES_LIKE]->(:Merchant) RETURN count(r) AS merchant_links;
MATCH (g:BehaviourGroup)<-[r:IN_BEHAVIOUR_GROUP]-() RETURN g.group_id, g.entity, count(r) AS members ORDER BY g.group_id;
